  m_Name: 
  m_EditorClassIdentifier: 
  objectHighlighted: {fileID: 0}
  interactibleName: 
  continueText: Continue
  texts:
  - text: Do you think throwing away food like this might be a sign that someone
      is struggling with how they feel about their body or themselves?
    jumpTo: -1
    taskToComplete: {fileID: 0}
    headMovementOption: 0
    options:
    - text: Yes
      jumpTo: -1
      pointsToAward: 0
    - text: No
      jumpTo: -1
      pointsToAward: 0
  - text: When a young person is struggling with feelings of low mood, they might
      experience changes in their appetite (i.e eating more/less than usual)\n\nFor
      someone who struggles with body image issues, they might throw away food that
      they like to restrict their calories.
    jumpTo: -1
    taskToComplete: {fileID: 0}
    headMovementOption: 0
    options: []
