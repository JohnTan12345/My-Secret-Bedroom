  objectHighlighted: {fileID: 0}
  interactibleName: 
  continueText: Continue
  texts:
  - text: 'What would you do when you see such a room? '
    jumpTo: -1
    taskToComplete: {fileID: 0}
    headMovementOption: 0
    options:
    - text: Help them to clean up their room
      jumpTo: 1
      pointsToAward: 0
    - text: Show your concern
      jumpTo: 2
      pointsToAward: 0
  - text: Help Ash With Their Laundry
    jumpTo: 3
    taskToComplete: {fileID: 4587393436131762933}
    headMovementOption: 0
    options: []
  - text: Use gentle tones to empathise and lend Ash a listening ear
    jumpTo: -1
    taskToComplete: {fileID: 0}
    headMovementOption: 0
    options: []
  - text: 'A young person experiencing mental health distress might be so affected
      by their low mood and low energy levels that they have difficulty keeping their
      room organised or doing household chores. '
    jumpTo: -1
    taskToComplete: {fileID: 0}
    headMovementOption: 0
    options: []
  - text: "Small gestures of understanding\u2014like asking how they're doing or
      offering practical help\u2014can provide valuable support."
    jumpTo: -1
    taskToComplete: {fileID: 0}
    headMovementOption: 0
    options: []
