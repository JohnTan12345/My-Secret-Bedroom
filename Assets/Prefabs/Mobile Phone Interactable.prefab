  m_Name: 
  m_EditorClassIdentifier: 
  objectHighlighted: {fileID: 0}
  interactibleName: 
  continueText: Continue
  texts:
  - text: "To outsiders, the missed messages and calls, and increased sleep might
      look like the young person is \u201Clazy\u201D or is \u201Canti-social\u201D."
    jumpTo: -1
    taskToComplete: {fileID: 0}
    headMovementOption: 0
    options: []
  - text: "However, it\u2019s important to look beneath the surface \u2013 When young
      people are experiencing mental health struggles, they might not have the physical
      and emotional energy to stay connected with others and might cope with their
      distress by sleeping more and rejecting social activities."
    jumpTo: -1
    taskToComplete: {fileID: 0}
    headMovementOption: 0
    options: []
  currentTextElementNumber: 0
