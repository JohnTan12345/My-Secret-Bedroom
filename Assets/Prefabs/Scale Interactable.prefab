  interactibleName: 
  continueText: Continue
  texts:
  - text: 'Is it healthy to  weigh yourself,  every 15 minutes? '
    jumpTo: -1
    taskToComplete: {fileID: 0}
    options:
    - isAButton: 0
      text: Yes
      jumpTo: 1
      pointsToAward: 0
    - isAButton: 0
      text: No
      jumpTo: 1
      pointsToAward: 0
  - text: When a young person is struggling with their body image, they might become
      obsessed with their weight and how they look.
    jumpTo: -1
    taskToComplete: {fileID: 0}
    options: []
  - text: This can sometimes lead to frequent monitoring of weight.
    jumpTo: -1
    taskToComplete: {fileID: 0}
    options: []
